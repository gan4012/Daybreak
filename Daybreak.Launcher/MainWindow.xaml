<ui:FluentWindow
    x:Class="Daybreak.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Daybreak.Launcher.ViewModels"
    Title="Daybreak 破晓启动器"
    Width="1280"
    Height="820"
    MinWidth="960"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Acrylic"
    ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <!-- 导航项焦点环:2px 品牌暖色,外扩 2px,跟随 10px 圆角 -->
        <Style x:Key="NavFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle
                            RadiusX="10"
                            RadiusY="10"
                            Margin="-2"
                            Stroke="#F2A15C"
                            StrokeThickness="2"
                            SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导航项容器:40 高 / 10 圆角 / 左右等宽 10 内边距;三态全部中性白,无渐变无竖条 -->
        <Style x:Key="NavItemContainer" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource NavFocusVisual}" />
            <Setter Property="Foreground">
                <Setter.Value>
                    <SolidColorBrush Color="#9EFFFFFF" />
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTip" Value="{Binding Label}" />
            <Setter Property="ToolTipService.IsEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Root"
                            Height="40"
                            CornerRadius="10"
                            Background="#00FFFFFF"
                            BorderThickness="1"
                            BorderBrush="#00FFFFFF"
                            Padding="10,0"
                            SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0DFFFFFF" />
                                <Setter Property="Foreground" Value="#EBFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                    Value="True">
                    <Setter Property="ToolTipService.IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 导航项内容:线性图标 18 + 文字 14/20,gap 10;折叠时只留图标(悬浮信息由 tooltip 承担) -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItemViewModel}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    x:Name="ItemIcon"
                    Symbol="{Binding Icon}"
                    Width="18"
                    Height="18"
                    FontSize="18" />
                <TextBlock
                    x:Name="ItemText"
                    Text="{Binding Label}"
                    FontSize="14"
                    LineHeight="20"
                    FontWeight="Medium"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger
                    Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Value="True">
                    <Setter TargetName="ItemIcon" Property="ui:SymbolIcon.Foreground" Value="#F2A16E" />
                </DataTrigger>
                <DataTrigger
                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Value="True">
                    <Setter TargetName="ItemIcon" Property="ui:SymbolIcon.Foreground" Value="#EBFFFFFF" />
                </DataTrigger>
                <DataTrigger
                    Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                    Value="True">
                    <Setter TargetName="ItemText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 玻璃后面的黎明光晕(纯装饰) -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="720" Canvas.Top="-180" Width="640" Height="640">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#5EFF8A3D" />
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="140" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Left="-260" Canvas.Top="220" Width="620" Height="620">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#4DF4517F" />
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="160" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Left="380" Canvas.Top="480" Width="560" Height="560">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#40FFC64D" />
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="150" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- 轻暗色罩:平衡文字对比度 -->
        <Rectangle Fill="#4D101418" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0">
                <ui:TitleBar.Header>
                    <TextBlock
                        Text="{Binding AppTitle}"
                        FontSize="12"
                        VerticalAlignment="Top"
                        Margin="16,7,0,0" />
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 悬浮导航面板:宽 240(折叠 64),左 16 / 上下 8,圆角 14,内边距 12 ===== -->
                <Border
                    x:Name="SidebarPanel"
                    Grid.Column="0"
                    Width="240"
                    Margin="16,8,0,8"
                    CornerRadius="14"
                    Background="#8C161318"
                    BorderBrush="#0FFFFFFF"
                    BorderThickness="1"
                    Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 品牌头:logo 20(品牌金) + "Daybreak" 13/600 + 折叠钮 28 -->
                        <Grid Grid.Row="0" Height="48">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon
                                    x:Name="BrandLogo"
                                    Symbol="WeatherSunny24"
                                    Width="20"
                                    Height="20"
                                    FontSize="20"
                                    Foreground="#F08A4B">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock
                                    x:Name="BrandText"
                                    Text="Daybreak"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#EBFFFFFF"
                                    VerticalAlignment="Center"
                                    Margin="10,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button
                                x:Name="NavToggle"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                FocusVisualStyle="{StaticResource NavFocusVisual}"
                                Click="OnNavToggle"
                                ToolTip="折叠 / 展开导航">
                                <ui:SymbolIcon
                                    x:Name="NavToggleIcon"
                                    Symbol="PanelLeftContract24"
                                    FontSize="16"
                                    Foreground="#9EFFFFFF" />
                            </Button>
                        </Grid>

                        <!-- 主导航 4 项 -->
                        <ListBox
                            x:Name="MainNav"
                            Grid.Row="2"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0"
                            ItemContainerStyle="{StaticResource NavItemContainer}"
                            ItemTemplate="{StaticResource NavItemTemplate}"
                            ItemsSource="{Binding NavItemsMain}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            KeyboardNavigation.TabNavigation="Continue"
                            SelectionChanged="OnMainNavSelectionChanged" />

                        <!-- 弹性空白(行高 *) -->

                        <!-- 分隔线:与 item 同宽(面板内边距内),不通栏 -->
                        <Rectangle
                            Grid.Row="4"
                            Height="1"
                            Fill="#14FFFFFF"
                            Margin="0,8" />

                        <!-- 底部导航 2 项 -->
                        <ListBox
                            x:Name="FooterNav"
                            Grid.Row="5"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0"
                            ItemContainerStyle="{StaticResource NavItemContainer}"
                            ItemTemplate="{StaticResource NavItemTemplate}"
                            ItemsSource="{Binding NavItemsFooter}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            KeyboardNavigation.TabNavigation="Continue"
                            SelectionChanged="OnFooterNavSelectionChanged" />
                    </Grid>
                </Border>

                <!-- ===== 内容区:与侧栏保持 24px 间距,滚动由各页面内部处理 ===== -->
                <Frame
                    x:Name="ContentHolder"
                    Grid.Column="2"
                    NavigationUIVisibility="Hidden"
                    Focusable="False" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
