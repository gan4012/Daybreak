<ui:FluentWindow
    x:Class="Daybreak.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:Daybreak.Launcher.Views.Pages"
    Title="Daybreak 破晓启动器"
    Width="1280"
    Height="820"
    MinWidth="960"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <ui:NavigationView
            x:Name="RootNavigation"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="首页"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:HomePage}" />
                <ui:NavigationViewItem
                    Content="下载游戏"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    TargetPageType="{x:Type pages:DownloadPage}" />
                <ui:NavigationViewItem
                    Content="版本管理"
                    Icon="{ui:SymbolIcon GridDots24}"
                    TargetPageType="{x:Type pages:VersionsPage}" />
                <ui:NavigationViewItem
                    Content="资源市场"
                    Icon="{ui:SymbolIcon PuzzlePiece24}"
                    TargetPageType="{x:Type pages:ModsPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="设置"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
                <ui:NavigationViewItem
                    Content="关于"
                    Icon="{ui:SymbolIcon Info24}"
                    TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TitleBar
                        Grid.Row="0"
                        Title="{Binding AppTitle}" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
