<ui:FluentWindow
    x:Class="Daybreak.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:Daybreak.Launcher.Views.Pages"
    Title="Daybreak 破晓启动器"
    Width="1280"
    Height="820"
    MinWidth="960"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Acrylic"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <!--
            玻璃后面的黎明光晕:三团模糊色块,给亚克力背景和玻璃卡片
            提供可透出的色彩层次(纯装饰,不响应鼠标)。
        -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="720" Canvas.Top="-180" Width="640" Height="640">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#5EFF8A3D" />
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="140" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Left="-260" Canvas.Top="220" Width="620" Height="620">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#4DF4517F" />
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="160" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Left="380" Canvas.Top="480" Width="560" Height="560">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#40FFC64D" />
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="150" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- 轻暗色罩:压低背景亮度,保证玻璃卡片上的文字对比度,同时保留亚克力透明感 -->
        <Rectangle Fill="#4D101418" IsHitTestVisible="False" />

        <!--
            悬浮侧边栏玻璃底板:WPF-UI 模板的窗格背景不可定制,
            因此在导航控件下面自绘一块带投影的圆角玻璃,宽度跟随窗格展开/收起。
        -->
        <Border
            HorizontalAlignment="Left"
            Margin="10,10,0,10"
            Padding="0"
            CornerRadius="18"
            BorderThickness="1"
            BorderBrush="{StaticResource GlassRimBrush}"
            Background="{StaticResource GlassFillBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.42" Color="#000000" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="{Binding OpenPaneLength, ElementName=RootNavigation}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPaneOpen, ElementName=RootNavigation}" Value="False">
                            <Setter Property="Width" Value="{Binding CompactPaneLength, ElementName=RootNavigation}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <ui:NavigationView
            x:Name="RootNavigation"
            Background="Transparent"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="首页"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:HomePage}" />
                <ui:NavigationViewItem
                    Content="下载游戏"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    TargetPageType="{x:Type pages:DownloadPage}" />
                <ui:NavigationViewItem
                    Content="版本管理"
                    Icon="{ui:SymbolIcon GridDots24}"
                    TargetPageType="{x:Type pages:VersionsPage}" />
                <ui:NavigationViewItem
                    Content="资源市场"
                    Icon="{ui:SymbolIcon PuzzlePiece24}"
                    TargetPageType="{x:Type pages:ModsPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="设置"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
                <ui:NavigationViewItem
                    Content="关于"
                    Icon="{ui:SymbolIcon Info24}"
                    TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--
                        模板的 Title 文字块垂直对齐与窗口按钮(高30、顶置,中心y=15)错位,
                        改用自定义 Header 文字块,顶部留白使其中心精确落在 15px。
                    -->
                    <ui:TitleBar Grid.Row="0">
                        <ui:TitleBar.Header>
                            <TextBlock
                                Text="{Binding AppTitle}"
                                FontSize="12"
                                VerticalAlignment="Top"
                                Margin="16,7,0,0" />
                        </ui:TitleBar.Header>
                    </ui:TitleBar>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
