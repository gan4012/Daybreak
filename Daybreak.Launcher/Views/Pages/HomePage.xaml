<Page
    x:Class="Daybreak.Launcher.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="32,28,32,24">

            <!-- 账号 -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PersonAccounts24" FontSize="20" Foreground="{StaticResource BrandAccentBrush}" />
                        <TextBlock Text="账号" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ui:TextBox
                        Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="16"
                        PlaceholderText="玩家名(离线模式)"
                        Margin="0,12,0,0" />
                    <TextBlock
                        Text="当前为离线登录,仅供单机与测试;微软正版与外置登录将在 M2 接入。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 启动 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="20" Foreground="{StaticResource BrandAccentBrush}" />
                        <TextBlock Text="启动" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            ItemsSource="{Binding InstalledVersions}"
                            SelectedItem="{Binding SelectedVersion}"
                            MinHeight="36" />
                        <ui:Button
                            Grid.Column="1"
                            Command="{Binding LoadVersionsCommand}"
                            Icon="{ui:SymbolIcon ArrowClockwise24}"
                            Content="刷新"
                            Margin="12,0,0,0"
                            MinHeight="36" />
                        <ui:Button
                            Grid.Column="2"
                            Command="{Binding DownloadJavaCommand}"
                            Icon="{ui:SymbolIcon DrinkCoffee24}"
                            Content="下载 Java"
                            ToolTip="自动下载与所选版本匹配的官方 Java 运行时"
                            Margin="12,0,0,0"
                            MinHeight="36" />
                        <Button
                            Grid.Column="3"
                            Command="{Binding LaunchCommand}"
                            Content="启动游戏"
                            Style="{StaticResource BrandPrimaryButton}"
                            Margin="12,0,0,0"
                            MinWidth="140" />
                    </Grid>

                    <ProgressBar
                        Height="6"
                        Margin="0,14,0,0"
                        Maximum="100"
                        Value="{Binding ProgressPercent, Mode=OneWay}"
                        IsIndeterminate="{Binding IsBusy, Mode=OneWay}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                    <TextBlock
                        Text="{Binding StatusText}"
                        Opacity="0.8"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0" />

                    <TextBox
                        Text="{Binding LogText, Mode=OneWay}"
                        IsReadOnly="True"
                        FontFamily="Consolas"
                        FontSize="11.5"
                        Height="180"
                        VerticalScrollBarVisibility="Auto"
                        TextChanged="OnLogTextChanged"
                        Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
