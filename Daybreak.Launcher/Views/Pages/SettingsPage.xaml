<Page
    x:Class="Daybreak.Launcher.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="32,28,32,24">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />

            <!-- 外观 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="深色主题" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="切换启动器的亮 / 暗外观,即时生效。" Opacity="0.7" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 游戏目录 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="游戏目录" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Minecraft 的 .minecraft 根目录。更改后版本列表需刷新(重启启动器或点各页的刷新)。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveGameDirectoryCommand}"
                            Content="保存"
                            MinHeight="34"
                            Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Java -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Java 路径" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Java 安装根目录(其下应有 bin/java.exe)。留空表示自动探测,找不到时会自动下载官方运行时。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding JavaDirectory, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveJavaDirectoryCommand}"
                            Content="保存"
                            MinHeight="34"
                            Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 内存 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="游戏内存(MB)" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="分配给游戏的堆内存,建议 2048~8192;过大会导致系统无法分配。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveMemoryCommand}"
                            Content="保存"
                            MinHeight="34"
                            Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 镜像 + 隔离 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="下载与隔离" FontSize="15" FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="下载镜像" FontSize="13" />
                            <TextBlock Text="官方源不可用或较慢时切换 BMCLAPI(国内加速)" FontSize="11.5" Opacity="0.6" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            SelectedIndex="{Binding SelectedMirrorIndex}"
                            MinWidth="140"
                            MinHeight="32">
                            <ComboBoxItem Content="官方源" />
                            <ComboBoxItem Content="BMCLAPI 镜像" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="版本隔离" FontSize="13" />
                            <TextBlock Text="每个版本独立的存档与配置目录(libraries/assets 仍共享)" FontSize="11.5" Opacity="0.6" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            IsChecked="{Binding VersionIsolation, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock
                Text="{Binding SettingsStatusText}"
                Opacity="0.85"
                TextWrapping="Wrap"
                Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
