<Page
    x:Class="Daybreak.Launcher.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="32,28,32,24">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />

            <!-- 外观 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="主题模式" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="切换启动器的亮 / 暗外观或跟随系统,即时生效。" Opacity="0.7" Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        SelectedIndex="{Binding SelectedThemeIndex}"
                        MinWidth="140"
                        MinHeight="32">
                        <ComboBoxItem Content="深色" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="跟随系统" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 背景效果 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="背景效果" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="窗口毛玻璃特效:Acrylic(半透明磨砂) / Mica(云母片) / 无特效。" Opacity="0.7" Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        SelectedIndex="{Binding SelectedBackdropIndex}"
                        MinWidth="140"
                        MinHeight="32">
                        <ComboBoxItem Content="Acrylic 磨砂" />
                        <ComboBoxItem Content="Mica 云母" />
                        <ComboBoxItem Content="无特效" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 游戏目录 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="游戏目录" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Minecraft 的 .minecraft 根目录。更改后版本列表需刷新(重启启动器或点各页的刷新)。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveGameDirectoryCommand}"
                            Content="保存"
                            MinHeight="34"
                            Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Java -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Java 路径" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Java 安装根目录(其下应有 bin/java.exe)。留空表示自动探测,找不到时会自动下载官方运行时。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding JavaDirectory, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveJavaDirectoryCommand}"
                            Content="保存"
                            MinHeight="34"
                            Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 内存 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="游戏内存(MB)" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="分配给游戏的堆内存,建议 2048~8192;过大会导致系统无法分配。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveMemoryCommand}"
                            Content="保存"
                            MinHeight="34"
                            Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- JVM 参数 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="高级 JVM 参数" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="自定义 Java 虚拟机启动参数(空格分隔),如 -XX:+UseG1GC -Dsun.rmi.dgc.server.gcInterval=600000。不要添加 -Xmx(与内存设置冲突)。留空则使用默认参数。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding JvmArguments, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" PlaceholderText="-XX:+UseG1GC" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveJvmArgumentsCommand}"
                            Content="保存"
                            MinHeight="34"
                            Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 微软登录 ClientId -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="微软应用 ClientId" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Azure AD 应用的 ClientId(发布前必须替换为自有应用)。留空则使用开发期备用 ID(有功能限制)。格式:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" PlaceholderText="粘贴你的 Azure 应用 ClientId" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveMicrosoftClientIdCommand}"
                            Content="保存"
                            MinHeight="34"
                            Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 镜像 + 隔离 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="下载与隔离" FontSize="15" FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="下载镜像" FontSize="13" />
                            <TextBlock Text="官方源不可用或较慢时切换 BMCLAPI(国内加速)" FontSize="11.5" Opacity="0.6" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            SelectedIndex="{Binding SelectedMirrorIndex}"
                            MinWidth="140"
                            MinHeight="32">
                            <ComboBoxItem Content="官方源" />
                            <ComboBoxItem Content="BMCLAPI 镜像" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="版本隔离" FontSize="13" />
                            <TextBlock Text="每个版本独立的存档与配置目录(libraries/assets 仍共享)" FontSize="11.5" Opacity="0.6" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            IsChecked="{Binding VersionIsolation, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 更新 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="更新" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="检查是否有新版本可用。需要 GitHub Releases 仓库已配置。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,2,0,0" />
                    <Button
                        Command="{Binding CheckForUpdatesCommand}"
                        Content="检查更新"
                        MinHeight="34"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource BrandPrimaryButton}" />
                </StackPanel>
            </Border>

            <!-- 网络代理 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="网络代理" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="校园网/企业网环境可能需要。仅影响启动器下载(版本、Mod、Java)。留空表示不使用代理。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,2,0,0" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:ToggleSwitch
                            Grid.Column="0"
                            IsChecked="{Binding ProxyEnabled, Mode=TwoWay}"
                            Margin="0,0,16,0" />
                        <ui:TextBox
                            Grid.Column="1"
                            Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}"
                            MinHeight="34"
                            PlaceholderText="代理地址(如 127.0.0.1)"
                            IsEnabled="{Binding ProxyEnabled}" />
                        <ui:TextBox
                            Grid.Column="2"
                            Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                            MinWidth="80"
                            MinHeight="34"
                            Margin="8,0,0,0"
                            PlaceholderText="端口"
                            IsEnabled="{Binding ProxyEnabled}" />
                    </Grid>
                    <ComboBox
                        SelectedIndex="{Binding SelectedProxyTypeIndex}"
                        MinWidth="120"
                        MinHeight="32"
                        Margin="0,8,0,0"
                        IsEnabled="{Binding ProxyEnabled}">
                        <ComboBoxItem Content="HTTP" />
                        <ComboBoxItem Content="SOCKS5" />
                    </ComboBox>
                    <Button
                        Command="{Binding SaveProxyCommand}"
                        Content="保存代理"
                        MinHeight="34"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource BrandPrimaryButton}" />
                </StackPanel>
            </Border>

            <TextBlock
                Text="{Binding SettingsStatusText}"
                Opacity="0.85"
                TextWrapping="Wrap"
                Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
