<Page 
    x:Class="Daybreak.Launcher.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="32,28,32,24">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />

            <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="主题模式与背景效果即时生效,设置会自动保存。"
                        Opacity="0.7"
                        Margin="0,2,0,0" />

                    <TextBlock Text="主题模式" FontSize="13" Opacity="0.85" Margin="0,16,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            x:Name="ThemeLightRadio"
                            GroupName="ThemeMode"
                            Tag="Light"
                            Content="浅色"
                            Margin="0,0,10,0"
                            Checked="ThemeMode_Checked" />
                        <RadioButton
                            x:Name="ThemeDarkRadio"
                            GroupName="ThemeMode"
                            Tag="Dark"
                            Content="深色"
                            Margin="0,0,10,0"
                            Checked="ThemeMode_Checked" />
                        <RadioButton
                            x:Name="ThemeSystemRadio"
                            GroupName="ThemeMode"
                            Tag="System"
                            Content="跟随系统"
                            Checked="ThemeMode_Checked" />
                    </StackPanel>

                    <TextBlock Text="背景效果" FontSize="13" Opacity="0.85" Margin="0,16,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            x:Name="BackdropAcrylicRadio"
                            GroupName="Backdrop"
                            Tag="Acrylic"
                            Content="亚克力(液态玻璃)"
                            Margin="0,0,10,0"
                            Checked="Backdrop_Checked" />
                        <RadioButton
                            x:Name="BackdropMicaRadio"
                            GroupName="Backdrop"
                            Tag="Mica"
                            Content="云母"
                            Margin="0,0,10,0"
                            Checked="Backdrop_Checked" />
                        <RadioButton
                            x:Name="BackdropNoneRadio"
                            GroupName="Backdrop"
                            Tag="None"
                            Content="不透明"
                            Checked="Backdrop_Checked" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="游戏目录" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="{Binding Config.GameDirectory, TargetNullValue='未设置(默认 %APPDATA%\.minecraft),M1 里程碑开放修改'}"
                        Opacity="0.7"
                        Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="下载镜像" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="{Binding Config.Mirror, FallbackValue='official'}"
                        Opacity="0.7"
                        Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
