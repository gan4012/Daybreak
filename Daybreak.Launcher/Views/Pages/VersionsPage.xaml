<Page 
    x:Class="Daybreak.Launcher.Views.Pages.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="32,28,32,24">
            <TextBlock Text="版本管理" FontSize="26" FontWeight="SemiBold" />
            <Border Style="{StaticResource BrandCard}" Margin="0,16,0,0">
                <StackPanel>
                    <ui:SymbolIcon Symbol="GridDots24" FontSize="24" Foreground="{StaticResource BrandAccentBrush}" />
                    <TextBlock Text="还没有游戏版本" FontSize="15" Margin="0,10,0,0" />
                    <TextBlock
                        Text="M3 里程碑接入:版本隔离、重命名 / 复制 / 删除 / 导出、实例图标。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
