<Page
    x:Class="Daybreak.Launcher.Views.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部:标题 + 筛选 + 刷新 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="下载游戏" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ui:Button
                Command="{Binding RefreshCommand}"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                Content="刷新清单"
                Appearance="Primary"
                Margin="20,0,0,0"
                MinHeight="34" />
            <ui:ToggleSwitch
                IsChecked="{Binding ShowAll, Mode=TwoWay}"
                ToolTip="包含快照与历史版本"
                Margin="20,0,0,0" />
            <TextBlock Text="显示快照与历史版本" Opacity="0.8" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <!-- 版本列表 -->
        <ListBox
            Grid.Row="1"
            ItemsSource="{Binding Versions}"
            Background="Transparent"
            BorderThickness="0"
            Margin="0,16,0,0"
            ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="Root"
                                    CornerRadius="10"
                                    Background="#0DFFFFFF"
                                    BorderBrush="#14FFFFFF"
                                    BorderThickness="1"
                                    Padding="16,10">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border
                                    CornerRadius="6"
                                    Background="#14FFFFFF"
                                    Padding="6,1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeDisplay}" FontSize="11" Opacity="0.85" />
                                </Border>
                                <Border
                                    CornerRadius="6"
                                    Background="#26FFC64D"
                                    Padding="6,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="已安装" FontSize="11" Foreground="#FFC64D" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding TimeDisplay}" FontSize="11.5" Opacity="0.6" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="96"
                            MinHeight="34"
                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BrandPrimaryButton}">
                                    <Setter Property="Content" Value="安装" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Content" Value="已安装" />
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部进度 -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <ProgressBar
                Height="6"
                Maximum="100"
                Value="{Binding ProgressPercent, Mode=OneWay}"
                IsIndeterminate="{Binding IsBusy, Mode=OneWay}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
            <TextBlock
                Text="{Binding StatusText}"
                Opacity="0.8"
                TextWrapping="Wrap"
                Margin="0,8,0,0" />
            <TextBlock
                Text="{Binding CurrentFile}"
                FontFamily="Consolas"
                FontSize="11"
                Opacity="0.5"
                TextTrimming="CharacterEllipsis"
                Margin="0,3,0,0" />
        </StackPanel>
    </Grid>
</Page>
