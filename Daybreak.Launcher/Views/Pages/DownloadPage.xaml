<Page
    x:Class="Daybreak.Launcher.Views.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部:标题 + 筛选 + 刷新 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="下载游戏" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ui:Button
                Command="{Binding RefreshCommand}"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                Content="刷新清单"
                Appearance="Primary"
                Margin="20,0,0,0"
                MinHeight="34" />
            <ui:ToggleSwitch
                IsChecked="{Binding ShowAll, Mode=TwoWay}"
                ToolTip="包含快照与历史版本"
                Margin="20,0,0,0" />
            <TextBlock Text="显示快照与历史版本" Opacity="0.8" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Mod 加载器安装(M3) -->
        <Border
            Grid.Row="1"
            Style="{StaticResource GlassCard}"
            Padding="14,10"
            Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Mod 加载器:" FontSize="13" VerticalAlignment="Center" Opacity="0.85" />
                <ComboBox
                    ItemsSource="{Binding LoaderModes}"
                    SelectedIndex="{Binding SelectedLoaderIndex}"
                    MinWidth="110"
                    MinHeight="32"
                    Margin="8,0,0,0" />
                <ComboBox
                    ItemsSource="{Binding GameVersions}"
                    SelectedItem="{Binding SelectedGameVersion}"
                    MinWidth="130"
                    MinHeight="32"
                    Margin="12,0,0,0"
                    Visibility="{Binding IsLoaderMode, Converter={StaticResource BoolToVisibility}}" />
                <ComboBox
                    ItemsSource="{Binding LoaderVersions}"
                    SelectedItem="{Binding SelectedLoaderVersion}"
                    DisplayMemberPath="Name"
                    MinWidth="190"
                    MinHeight="32"
                    Margin="8,0,0,0"
                    Visibility="{Binding ShowLoaderVersionCombo, Converter={StaticResource BoolToVisibility}}" />
                <Button
                    Command="{Binding InstallLoaderCommand}"
                    Content="安装加载器"
                    Style="{StaticResource BrandPrimaryButton}"
                    MinWidth="110"
                    Margin="12,0,0,0"
                    Visibility="{Binding IsLoaderMode, Converter={StaticResource BoolToVisibility}}" />
                <ui:ToggleSwitch
                    IsChecked="{Binding VersionIsolation, Mode=TwoWay}"
                    ToolTip="每个版本独立的存档与配置目录(libraries/assets 仍共享)"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center" />
                <TextBlock Text="版本隔离" Opacity="0.8" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 版本列表 -->
        <ListBox
            Grid.Row="2"
            ItemsSource="{Binding Versions}"
            Background="Transparent"
            BorderThickness="0"
            Margin="0,16,0,0"
            ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="Root"
                                    CornerRadius="10"
                                    Background="#0DFFFFFF"
                                    BorderBrush="#14FFFFFF"
                                    BorderThickness="1"
                                    Padding="16,10">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border
                                    CornerRadius="6"
                                    Background="#14FFFFFF"
                                    Padding="6,1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeDisplay}" FontSize="11" Opacity="0.85" />
                                </Border>
                                <Border
                                    CornerRadius="6"
                                    Background="#26FFC64D"
                                    Padding="6,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="已安装" FontSize="11" Foreground="#FFC64D" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding TimeDisplay}" FontSize="11.5" Opacity="0.6" Margin="0,3,0,0" />

                            <!-- 逐项安装进度条 -->
                            <ProgressBar
                                Height="4"
                                Margin="0,8,0,0"
                                Maximum="100"
                                Value="{Binding InstallPercent, Mode=OneWay}"
                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="96"
                            MinHeight="34"
                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BrandPrimaryButton}">
                                    <Setter Property="Content" Value="安装" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Content" Value="已安装" />
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                            <Setter Property="Content" Value="下载中…" />
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 下载中心:当前任务 + 已安装列表(常驻) -->
        <Border
            Grid.Row="3"
            Style="{StaticResource GlassCard}"
            Padding="16,12"
            Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Foreground="{StaticResource BrandAccentBrush}" />
                        <TextBlock Text="下载" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding ActiveDownloadName, TargetNullValue='没有正在进行的下载'}"
                            FontSize="13"
                            Opacity="0.9"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding DownloadedBytesDisplay}"
                        FontFamily="Consolas"
                        FontSize="11.5"
                        Opacity="0.75"
                        VerticalAlignment="Center" />
                </Grid>

                <ProgressBar
                    Height="5"
                    Margin="0,10,0,0"
                    Maximum="100"
                    Value="{Binding ProgressPercent, Mode=OneWay}"
                    IsIndeterminate="{Binding IsBusy, Mode=OneWay}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                <TextBlock
                    Text="{Binding CurrentFile}"
                    FontFamily="Consolas"
                    FontSize="11"
                    Opacity="0.55"
                    TextTrimming="CharacterEllipsis"
                    Margin="0,6,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                <!-- 已安装列表 -->
                <TextBlock
                    FontSize="12"
                    Opacity="0.7"
                    Margin="0,10,0,0">
                    <Run Text="已安装" /><Run Text=" (" /><Run Text="{Binding InstalledVersions.Count, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
                <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding InstalledVersions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    CornerRadius="8"
                                    Background="#14FFFFFF"
                                    Padding="10,4"
                                    Margin="0,2,8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{Binding SizeDisplay}"
                                            FontSize="11"
                                            Opacity="0.6"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    Text="{Binding StatusText}"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
