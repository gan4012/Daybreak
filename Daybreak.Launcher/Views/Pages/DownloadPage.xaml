<Page 
    x:Class="Daybreak.Launcher.Views.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="32,28,32,24">
            <TextBlock Text="下载游戏" FontSize="26" FontWeight="SemiBold" />
            <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                <StackPanel>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="24" Foreground="{StaticResource BrandAccentBrush}" />
                    <TextBlock Text="版本列表加载中…" FontSize="15" Margin="0,10,0,0" />
                    <TextBlock
                        Text="M1 里程碑接入:版本清单(官方 / BMCLAPI)、原版下载、Fabric / Forge / NeoForge 安装。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
