<Project>

  <!--
    统一版本号:所有项目共用。
    发布流程:改这里的版本 → 提交 → 打同名 tag(如 v0.1.2)推两端
    → GitHub CI 按 tag 构建发布 → 本地打包后 publish-gitee.ps1 上传 Gitee。
    自更新器读主程序 exe 的 FileVersion 与 tag 比较(见 Program.GetLauncherVersion)。
  -->
  <PropertyGroup>
    <Version>0.1.4</Version>
    <Company>Daybreak</Company>
    <Product>Daybreak 破晓启动器</Product>
    <Copyright>Copyright © 2026 Daybreak</Copyright>
  </PropertyGroup>

</Project>