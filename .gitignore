# EasyTier 二进制不进 git(约 24MB),只保留许可证与说明文本。
# scripts/package.ps1 会在打包前自动检测/下载。
third_party/easytier/*.exe
third_party/easytier/*.dll
third_party/easytier/*.sys

# 中继节点地址:不进 git,避免公开仓库里公示自建服务器
third_party/easytier/relay.txt

# 官网:部署脚本里的服务器地址与本地审阅产物都不进 git
website/deploy/server.txt
website/_preview/

# 图标生成的预览帧(可由 scripts/make-icon.py 重新导出)
**/_icon-preview/

# 分发包的校验文件属于构建产物
*.sha256

# 演示视频的录屏素材与生成物(体积大、可重新生成)
docs/video/配音输出*/
docs/video/clips/
