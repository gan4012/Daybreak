<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Daybreak.Core\Daybreak.Core.csproj" />
    <ProjectReference Include="..\Daybreak.Market\Daybreak.Market.csproj" />
  </ItemGroup>

  <!--
    EasyTier 联机组件随程序分发,输出到 easytier/ 子目录。
    以独立子进程方式调用(不链接),符合其 LGPL-3.0 要求。
    .exe/.dll/.sys 不进 git(见 .gitignore),由 scripts/package.ps1 保证存在;
    本地开发若缺失,联机页会明确提示"组件缺失"而不是静默失败。
  -->
  <ItemGroup>
    <Content Include="..\..\third_party\easytier\**\*">
      <Link>easytier\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!--
        必须同时设 CopyToPublishDirectory:只设 CopyToOutputDirectory 时,
        单文件发布(dotnet publish -p:PublishSingleFile=true)只带出了 .txt,
        exe/dll/sys 全丢 —— 打出来的包看起来正常,但联机功能直接不能用。
      -->
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      应用图标。由 scripts/make-icon.py 生成(多尺寸 16~256)。
      设置这一项后,exe 图标、任务栏、标题栏、Alt+Tab 都会跟着变。
    -->
    <ApplicationIcon>daybreak.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 图标文件要让 WPF 也能取到(窗口 Icon 绑定用) -->
  <ItemGroup>
    <Resource Include="daybreak.ico" />
  </ItemGroup>

</Project>
