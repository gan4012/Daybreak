<Page
    x:Class="Daybreak.Launcher.Views.Pages.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 搜索行 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="搜索 Mod / 资源包 / 光影 / 整合包…"
                MinHeight="36"
                KeyDown="OnSearchKeyDown" />
            <ComboBox
                Grid.Column="1"
                ItemsSource="{Binding TypeModes}"
                SelectedIndex="{Binding SelectedTypeIndex}"
                MinWidth="100"
                MinHeight="36"
                Margin="12,0,0,0" />
            <Button
                Grid.Column="2"
                Command="{Binding SearchCommand}"
                Content="搜索"
                Style="{StaticResource BrandPrimaryButton}"
                MinWidth="96"
                Margin="12,0,0,0" />
            <ui:Button
                Grid.Column="3"
                Command="{Binding ImportPackCommand}"
                Icon="{ui:SymbolIcon ArrowImport24}"
                Content="导入整合包"
                ToolTip="导入 mrpack(Modrinth)或 zip(CurseForge)整合包到当前选中版本"
                MinHeight="36"
                Margin="12,0,0,0" />
        </Grid>

        <!-- 目标版本行 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="安装到版本:" FontSize="13" Opacity="0.8" VerticalAlignment="Center" />
            <ComboBox
                ItemsSource="{Binding InstalledVersions}"
                SelectedItem="{Binding SelectedTargetVersion}"
                MinWidth="220"
                MinHeight="32"
                Margin="8,0,0,0" />
            <TextBlock
                Text="{Binding StatusText}"
                Opacity="0.7"
                FontSize="12"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 结果列表 -->
        <ListBox
            Grid.Row="2"
            ItemsSource="{Binding Results}"
            Background="Transparent"
            BorderThickness="0"
            Margin="0,14,0,0"
            ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="Root"
                                    CornerRadius="10"
                                    Background="#0DFFFFFF"
                                    BorderBrush="#14FFFFFF"
                                    BorderThickness="1"
                                    Padding="14,10">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Author}" FontSize="11.5" Opacity="0.6" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="12" Opacity="0.5" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding DownloadsDisplay}" FontSize="11.5" Opacity="0.6" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding Description}"
                                FontSize="12"
                                Opacity="0.7"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,3,0,0" />
                            <ProgressBar
                                Height="4"
                                Margin="0,8,0,0"
                                Maximum="100"
                                Value="{Binding InstallPercent, Mode=OneWay}"
                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="88"
                            MinHeight="32"
                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BrandPrimaryButton}">
                                    <Setter Property="Content" Value="安装" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                            <Setter Property="Content" Value="安装中…" />
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部进度 -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar
                Height="5"
                Maximum="100"
                Value="{Binding ProgressPercent, Mode=OneWay}"
                IsIndeterminate="{Binding IsBusy, Mode=OneWay}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
            <TextBlock
                Text="{Binding CurrentFile}"
                FontFamily="Consolas"
                FontSize="11"
                Opacity="0.55"
                TextTrimming="CharacterEllipsis"
                Margin="0,6,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
            <TextBlock
                Text="{Binding SpeedDisplay}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrandAccentBrush}"
                Opacity="0.9"
                Margin="0,4,0,0"
                Visibility="{Binding SpeedDisplay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</Page>
