<Page
    x:Class="Daybreak.Launcher.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <app:InverseBooleanConverter x:Key="InverseBool" xmlns:app="clr-namespace:Daybreak.Launcher" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="32,28,32,24">

            <!-- 账号 -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PersonAccounts24" FontSize="20" Foreground="{StaticResource BrandAccentBrush}" />
                            <!-- 头像 -->
                            <Border
                                CornerRadius="6"
                                Width="32"
                                Height="32"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="#14FFFFFF">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Auth.AvatarUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Image
                                Source="{Binding Auth.AvatarUrl}"
                                Width="32"
                                Height="32"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,32,32" RadiusX="6" RadiusY="6" />
                                </Image.Clip>
                            </Image>
                            <TextBlock Text="账号" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock
                                Text="{Binding Auth.ActiveAccountDisplay}"
                                FontSize="13"
                                Opacity="0.85"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            SelectedIndex="{Binding Auth.SelectedModeIndex}"
                            MinWidth="130"
                            MinHeight="32">
                            <ComboBoxItem Content="离线登录" />
                            <ComboBoxItem Content="微软正版" />
                            <ComboBoxItem Content="外置登录" />
                        </ComboBox>
                    </Grid>

                    <!-- 离线登录 -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Auth.SelectedModeIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Text="{Binding Auth.PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="16"
                                PlaceholderText="玩家名(离线模式,仅供单机与测试)" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding Auth.AddOfflineAccountCommand}"
                                Content="保存账号"
                                Margin="12,0,0,0"
                                MinHeight="34" />
                        </Grid>
                    </StackPanel>

                    <!-- 微软正版 -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Auth.SelectedModeIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Command="{Binding Auth.MicrosoftLoginCommand}"
                                Content="登录微软正版(设备码)"
                                MinHeight="34"
                                IsEnabled="{Binding Auth.IsAuthBusy, Converter={StaticResource InverseBool}}" />
                            <Button
                                Command="{Binding Auth.OpenDeviceCodeUrlCommand}"
                                Content="打开授权页面"
                                Margin="12,0,0,0"
                                MinHeight="34"
                                Visibility="{Binding Auth.DeviceCodeVisible, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <Border
                            CornerRadius="10"
                            Background="#14FFFFFF"
                            Padding="14,10"
                            Margin="0,10,0,0"
                            Visibility="{Binding Auth.DeviceCodeVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="验证码:" FontSize="13" VerticalAlignment="Center" Opacity="0.8" />
                                <TextBlock
                                    Text="{Binding Auth.DeviceCodeText}"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    FontFamily="Consolas"
                                    Foreground="{StaticResource BrandAccentBrush}"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 外置登录 -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Auth.SelectedModeIndex}" Value="2">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Text="{Binding Auth.ExternalServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="服务器地址(如 littleskin.cn)"
                                Margin="0,0,8,0" />
                            <ui:TextBox
                                Grid.Column="1"
                                Text="{Binding Auth.ExternalUsername, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="账号"
                                Margin="0,0,8,0" />
                            <ui:TextBox
                                Grid.Column="2"
                                Text="{Binding Auth.ExternalPassword, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="密码" />
                            <Button
                                Grid.Column="3"
                                Command="{Binding Auth.ExternalLoginCommand}"
                                Content="登录"
                                Margin="12,0,0,0"
                                MinHeight="34" />
                        </Grid>
                    </StackPanel>

                    <!-- 认证状态 + 已保存账号 -->
                    <TextBlock
                        Text="{Binding Auth.AuthStatusText}"
                        Opacity="0.75"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="已保存账号:" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                        <ComboBox
                            ItemsSource="{Binding Auth.Accounts}"
                            SelectedItem="{Binding Auth.SelectedAccount}"
                            DisplayMemberPath="Name"
                            MinWidth="200"
                            MinHeight="30"
                            Margin="8,0,0,0" />
                        <Button
                            Command="{Binding Auth.RemoveAccountCommand}"
                            CommandParameter="{Binding Auth.SelectedAccount}"
                            Content="移除"
                            MinHeight="30"
                            Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 启动 -->
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="20" Foreground="{StaticResource BrandAccentBrush}" />
                        <TextBlock Text="启动" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            ItemsSource="{Binding InstalledVersions}"
                            SelectedItem="{Binding SelectedVersion}"
                            MinHeight="36" />
                        <ui:Button
                            Grid.Column="1"
                            Command="{Binding LoadVersionsCommand}"
                            Icon="{ui:SymbolIcon ArrowClockwise24}"
                            Content="刷新"
                            Margin="12,0,0,0"
                            MinHeight="36" />
                        <ui:Button
                            Grid.Column="2"
                            Command="{Binding OpenJavaDownloadSiteCommand}"
                            Icon="{ui:SymbolIcon DrinkCoffee24}"
                            Content="下载 Java"
                            ToolTip="打开清华镜像的 Java(Adoptium Temurin)下载页,国内直连可下载"
                            Margin="12,0,0,0"
                            MinHeight="36" />
                        <Button
                            Grid.Column="3"
                            Command="{Binding LaunchCommand}"
                            Style="{StaticResource BrandLaunchButton}"
                            Margin="16,0,0,0"
                            ToolTip="用选中的版本启动游戏">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Symbol="Play24"
                                    Filled="True"
                                    Foreground="White"
                                    FontSize="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="启动游戏"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ProgressBar
                        Height="6"
                        Margin="0,14,0,0"
                        Maximum="100"
                        Value="{Binding ProgressPercent, Mode=OneWay}"
                        IsIndeterminate="{Binding IsBusy, Mode=OneWay}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                    <TextBlock
                        Text="{Binding StatusText}"
                        Opacity="0.8"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0" />

                    <TextBox
                        Text="{Binding LogText, Mode=OneWay}"
                        IsReadOnly="True"
                        FontFamily="Consolas"
                        FontSize="11.5"
                        Height="180"
                        VerticalScrollBarVisibility="Auto"
                        TextChanged="OnLogTextChanged"
                        Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
