<Page
    x:Class="Daybreak.Launcher.Views.Pages.MultiplayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- 页面级样式:用 DataTrigger 控制可见性(本项目不使用 Converter,统一走 DataTrigger) -->
    <Page.Resources>
        <Style x:Key="ServersTabPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsServersTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListTabPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LanTabPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLanTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoomTabPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRoomTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="联机" FontSize="26" FontWeight="SemiBold" />
            <TextBlock
                Text="自己开服请朋友进来,或者加入别人的服务器。"
                FontSize="13"
                Opacity="0.7"
                Margin="0,4,0,0" />
        </StackPanel>

        <!-- Tab 切换 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton x:Name="TabServers" Content="我的服务端" GroupName="MpTabs"
                         MinHeight="34" Padding="16,4" IsChecked="True" Checked="OnTabChanged" />
            <RadioButton x:Name="TabList" Content="服务器列表" GroupName="MpTabs"
                         MinHeight="34" Padding="16,4" Margin="10,0,0,0" Checked="OnTabChanged" />
            <RadioButton x:Name="TabLan" Content="局域网" GroupName="MpTabs"
                         MinHeight="34" Padding="16,4" Margin="10,0,0,0" Checked="OnTabChanged" />
            <RadioButton x:Name="TabRoom" Content="好友联机" GroupName="MpTabs"
                         MinHeight="34" Padding="16,4" Margin="10,0,0,0" Checked="OnTabChanged" />
        </StackPanel>

        <!-- 内容区 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">

            <!-- ===== Tab 0:我的服务端 ===== -->
            <Grid Style="{StaticResource ServersTabPanel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧:服务端列表 -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="服务端" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button
                                Command="{Binding RefreshServersCommand}"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                Content="刷新"
                                MinHeight="30"
                                Margin="12,0,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <!-- 空状态 -->
                            <TextBlock
                                Text="还没有服务端&#x0a;点下方按钮创建一个"
                                Opacity="0.5"
                                FontSize="12"
                                TextAlignment="Center"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasServers}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox
                                ItemsSource="{Binding Servers}"
                                SelectedItem="{Binding SelectedServer}"
                                Background="Transparent"
                                BorderThickness="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4" MinWidth="240">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="9" Height="9"
                                                     VerticalAlignment="Center" Fill="{Binding StateColor}" />
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding VersionDisplay, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding StateText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Button Grid.Row="2" Content="＋ 新建服务端" MinHeight="34"
                                HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                Click="OnOpenCreateServer" />
                    </Grid>
                </Border>

                <!-- 右侧:详情 / 控制台 -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="16,14" Margin="14,0,0,0">
                    <Grid>
                        <!-- 空状态 -->
                        <TextBlock
                            Text="从左侧选择一个服务端,或点「新建服务端」创建一个。"
                            Opacity="0.55" FontSize="13"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedServer}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedServer}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题 + 操作 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedServer.Name}" FontSize="17" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                 Fill="{Binding SelectedServer.StateColor}" />
                                        <TextBlock Text="{Binding SelectedServer.StateText}" FontSize="12"
                                                   Opacity="0.75" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedServer.VersionDisplay}" FontSize="12"
                                                   Opacity="0.55" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12" Opacity="0.55" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Run Text="端口" />
                                            <Run Text="{Binding SelectedServer.Port, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <ui:Button
                                        Command="{Binding StartServerCommand}"
                                        CommandParameter="{Binding SelectedServer}"
                                        Icon="{ui:SymbolIcon Play24}"
                                        Content="启动"
                                        MinHeight="34"
                                        Style="{StaticResource BrandPrimaryButton}" />
                                    <ui:Button
                                        Command="{Binding StopServerCommand}"
                                        CommandParameter="{Binding SelectedServer}"
                                        Icon="{ui:SymbolIcon Stop24}"
                                        Content="停止"
                                        MinHeight="34"
                                        Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- 提示条 -->
                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <Border CornerRadius="8" Background="#2AF0A05A" Padding="12,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedServer.NeedsEula}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Warning24" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock Text="尚未同意 Minecraft EULA,服务端无法启动。"
                                                       FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="阅读并同意" MinHeight="28" Padding="12,2"
                                                Click="OnAcceptEula" />
                                    </Grid>
                                </Border>

                                <Border CornerRadius="8" Background="#2ACF6B6B" Padding="12,8" Margin="0,6,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedServer.PortInUse}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Text="该端口当前被占用,服务端可能无法启动。"
                                                   FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 控制台 -->
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="控制台" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="打开目录" MinHeight="26" Padding="10,2" Click="OnOpenServerFolder" />
                                        <Button Content="清空" MinHeight="26" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding ClearConsoleCommand}" />
                                        <Button Content="删除" MinHeight="26" Padding="10,2" Margin="6,0,0,0"
                                                Click="OnDeleteServer" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" CornerRadius="8" Background="#22000000" Margin="0,8,0,0">
                                    <TextBox
                                        Text="{Binding SelectedServer.ConsoleText, Mode=OneWay}"
                                        IsReadOnly="True"
                                        FontFamily="Consolas"
                                        FontSize="11.5"
                                        Foreground="#D8FFFFFF"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="10,8"
                                        TextWrapping="NoWrap"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Auto"
                                        IsUndoEnabled="False" />
                                </Border>
                            </Grid>

                            <!-- 命令输入 -->
                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Grid.Column="0"
                                    Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}"
                                    MinHeight="32"
                                    FontFamily="Consolas"
                                    PlaceholderText="输入命令,如 op 玩家名 / whitelist add 玩家名 / say 你好"
                                    KeyDown="OnConsoleKeyDown" />
                                <ui:Button
                                    Grid.Column="1"
                                    Icon="{ui:SymbolIcon Send24}"
                                    Content="发送"
                                    MinHeight="32"
                                    Margin="8,0,0,0"
                                    Command="{Binding SendConsoleCommandCommand}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Tab 1:服务器列表 ===== -->
            <Grid Style="{StaticResource ListTabPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="0"
                            Text="{Binding NewServerAddress, UpdateSourceTrigger=PropertyChanged}"
                            MinHeight="32"
                            PlaceholderText="服务器地址,如 mc.example.com 或 1.2.3.4:25565" />
                        <ui:TextBox
                            Grid.Column="1"
                            Text="{Binding NewServerAlias, UpdateSourceTrigger=PropertyChanged}"
                            MinHeight="32"
                            Margin="10,0,0,0"
                            PlaceholderText="备注名(可选)" />
                        <ui:Button
                            Grid.Column="2"
                            Icon="{ui:SymbolIcon Add24}"
                            Content="添加"
                            MinHeight="32"
                            Margin="10,0,0,0"
                            Command="{Binding AddSavedServerCommand}"
                            Style="{StaticResource BrandPrimaryButton}" />
                        <ui:Button
                            Grid.Column="3"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Content="查询全部"
                            MinHeight="32"
                            Margin="8,0,0,0"
                            Command="{Binding RefreshAllSavedServersCommand}" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Text="还没有收藏的服务器。&#x0a;在上面填入地址后点「添加」,就能看到在线人数并一键进服。"
                            Opacity="0.5" FontSize="12"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,30,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SavedServers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding SavedServers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="#14FFFFFF" Padding="14,10" Margin="0,0,8,8">
                                        <Grid MinWidth="760">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#8A8A8A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="#7ACC7A" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Address, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Motd, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                       Margin="10,0,0,0" MinWidth="60" TextAlignment="Right"
                                                       Text="{Binding PlayerDisplay}" />

                                            <TextBlock Grid.Column="3" FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" MinWidth="60" TextAlignment="Right"
                                                       Text="{Binding LatencyDisplay}" />

                                            <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Play24}" Content="进服"
                                                       MinHeight="30" Margin="12,0,0,0"
                                                       Style="{StaticResource BrandPrimaryButton}"
                                                       Click="OnJoinSavedServer" />

                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button MinHeight="30" Padding="10,2" Click="OnToggleFavorite"
                                                        Content="{Binding FavoriteLabel}" />
                                                <Button Content="移除" MinHeight="30" Padding="10,2" Margin="6,0,0,0"
                                                        Click="OnRemoveSavedServer" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Tab 2:局域网 ===== -->
            <Grid Style="{StaticResource LanTabPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="局域网联机" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock
                            Text="让朋友在游戏里点「对局域网开放」,启动器会自动发现这个房间;同一网络下都能加入。"
                            FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Icon="{ui:SymbolIcon VirtualNetwork24}" Content="开始监听局域网"
                                       MinHeight="34" Command="{Binding ToggleLanScanCommand}" />
                            <ui:Button Icon="{ui:SymbolIcon Search24}" Content="扫描本机网段"
                                       MinHeight="34" Margin="10,0,0,0" Command="{Binding ScanLanByPortCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Text="还没有发现局域网房间。"
                            Opacity="0.5" FontSize="12"
                            HorizontalAlignment="Center" Margin="0,30,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLanWorlds}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding LanWorlds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="#14FFFFFF" Padding="14,10" Margin="0,0,8,8">
                                        <Grid MinWidth="600">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Motd}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock FontSize="11" Opacity="0.6">
                                                    <Run Text="{Binding Address, Mode=OneWay}" />
                                                    <Run Text=":" />
                                                    <Run Text="{Binding Port, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="局域网" FontSize="11" Opacity="0.6"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Play24}" Content="加入"
                                                       MinHeight="30" Margin="12,0,0,0"
                                                       Style="{StaticResource BrandPrimaryButton}"
                                                       Click="OnJoinLanWorld" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Tab 3:好友联机(EasyTier 虚拟组网) ===== -->
            <Grid Style="{StaticResource RoomTabPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- 组件缺失提示 -->
                        <Border CornerRadius="10" Background="#2ACF6B6B" Padding="14,10" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoomComponentReady}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="16" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding RoomComponentHint}" FontSize="12"
                                           TextWrapping="Wrap" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 未进房间:创建/加入 -->
                        <Border Padding="20,18">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRoomSetup}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="好友联机" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="点「创建房间」拿到 6 位房间号,好友在他的启动器里输入房间号即可加入。不需要公网 IP,跨网络也能连。"
                                    FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />

                                <TextBlock Text="你正在玩的版本" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <TextBlock Text="双方版本(含 Mod)必须一致,否则进不去。"
                                           FontSize="11.5" Opacity="0.6" Margin="0,2,0,0" />
                                <ComboBox ItemsSource="{Binding RoomGameVersions}"
                                          SelectedItem="{Binding SelectedRoomVersion}"
                                          MinHeight="34" Margin="0,6,0,0" MaxWidth="320" HorizontalAlignment="Left" />

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <ui:Button Icon="{ui:SymbolIcon Add24}" Content="创建房间"
                                               MinHeight="38" MinWidth="140"
                                               Style="{StaticResource BrandPrimaryButton}"
                                               Command="{Binding CreateRoomCommand}" />
                                    <TextBlock Text="或" FontSize="12" Opacity="0.5"
                                               VerticalAlignment="Center" Margin="16,0" />
                                    <ui:TextBox Text="{Binding RoomCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                                MinHeight="38" Width="150" MaxLength="6"
                                                PlaceholderText="6 位房间号" />
                                    <ui:Button Icon="{ui:SymbolIcon PlugConnected24}" Content="加入房间"
                                               MinHeight="38" Margin="10,0,0,0"
                                               Command="{Binding JoinRoomCommand}" />
                                </StackPanel>

                                <TextBlock Text="提示:房间号相当于密码,建议只告诉自己人;直播/录屏时注意遮挡。"
                                           FontSize="11.5" Opacity="0.55" TextWrapping="Wrap" Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 已在房间 -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Style="{StaticResource GlassCard}" Padding="20,18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="房间号" FontSize="12" Opacity="0.6" />
                                            <TextBlock Text="{Binding CurrentRoomCode}" FontSize="34"
                                                       FontWeight="SemiBold" FontFamily="Consolas"
                                                       Foreground="{StaticResource BrandAccentBrush}" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Copy24}" Content="复制"
                                                   MinHeight="34" VerticalAlignment="Center"
                                                   Command="{Binding CopyRoomCodeCommand}" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#8A8A8A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RoomPeerCount}" Value="0">
                                                            <Setter Property="Fill" Value="#E8C27A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12" Opacity="0.8"
                                                   VerticalAlignment="Center" Text="{Binding RoomStatusText}" />
                                    </Grid>

                                    <TextBlock FontSize="12" Opacity="0.7" Margin="0,12,0,0" TextWrapping="Wrap">
                                        <Run Text="游戏版本:" />
                                        <Run Text="{Binding RoomGameVersion, Mode=OneWay}" />
                                        <Run Text="  ·  已连接好友:" />
                                        <Run Text="{Binding RoomPeerCount, Mode=OneWay}" />
                                        <Run Text=" 人" />
                                    </TextBlock>

                                    <!-- 好友要填的地址 -->
                                    <Border CornerRadius="8" Background="#1AFFFFFF" Padding="12,10" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="好友在游戏「直接连接」里输入" FontSize="11.5" Opacity="0.65" />
                                            <TextBlock Text="{Binding RoomHostAddress}" FontSize="15"
                                                       FontFamily="Consolas" Margin="0,4,0,0"
                                                       Foreground="{StaticResource BrandAccentBrush}" />
                                            <TextBlock Text="(点下面的「启动游戏并进服」就不用自己输了)"
                                                       FontSize="11" Opacity="0.5" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <ui:Button Icon="{ui:SymbolIcon Play24}" Content="启动游戏并进服"
                                                   MinHeight="38" MinWidth="170"
                                                   Style="{StaticResource BrandPrimaryButton}"
                                                   Command="{Binding JoinRoomGameCommand}" />
                                        <Button Content="结束联机" MinHeight="38" Padding="18,4"
                                                Margin="10,0,0,0"
                                                Command="{Binding LeaveRoomCommand}" />
                                    </StackPanel>

                                    <TextBlock
                                        Text="⚠ 请确认好友使用与你完全相同的游戏版本与 Mod,否则会连接失败。"
                                        FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 联机日志 -->
                            <Border Style="{StaticResource GlassCard}" Padding="14,12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="联机日志" FontSize="13" FontWeight="SemiBold" />
                                    <Border CornerRadius="8" Background="#22000000" Margin="0,8,0,0">
                                        <TextBox Text="{Binding RoomLogText, Mode=OneWay}"
                                                 IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                                 Foreground="#D8FFFFFF" Background="Transparent"
                                                 BorderThickness="0" Padding="10,8"
                                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                                 Height="120"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 IsUndoEnabled="False" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部状态 -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Opacity="0.7"
                   TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
</Page>