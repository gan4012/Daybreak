<Page
    x:Class="Daybreak.Launcher.Views.Pages.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <!-- 第 4 行给底部状态文字:此前只定义了 3 行,而状态文字用 Grid.Row="3",
                 WPF 会把它挤到最后一行,导致与 Mod 管理卡片重叠。 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部:标题 + 详情 + 操作 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="版本管理" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedVersionInfo}" Opacity="0.75" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button
                    Command="{Binding OpenVersionFolderCommand}"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    Content="打开目录"
                    MinHeight="34" />
                <Button
                    Command="{Binding RenameVersionCommand}"
                    Content="重命名"
                    MinHeight="34"
                    Margin="10,0,0,0" />
                <Button
                    Command="{Binding CopyVersionCommand}"
                    Content="复制"
                    MinHeight="34"
                    Margin="10,0,0,0" />
                <Button
                    Command="{Binding DeleteVersionCommand}"
                    Content="删除版本"
                    MinHeight="34"
                    Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 版本列表 -->
        <ListBox
            Grid.Row="1"
            ItemsSource="{Binding Versions}"
            SelectedItem="{Binding SelectedVersion}"
            Background="Transparent"
            BorderThickness="0"
            Margin="0,14,0,0"
            ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="Root"
                                    CornerRadius="10"
                                    Background="#0DFFFFFF"
                                    BorderBrush="#14FFFFFF"
                                    BorderThickness="1"
                                    Padding="14,10">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#1AFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding SizeDisplay}"
                            FontSize="11.5"
                            Opacity="0.6"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Mod 管理 -->
        <Border
            Grid.Row="2"
            Style="{StaticResource GlassCard}"
            Padding="14,10"
            Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Mod 管理" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding SelectedVersion.Name, StringFormat=· {0}}"
                        FontSize="12"
                        Opacity="0.6"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center" />
                    <ui:Button
                        Command="{Binding CheckModUpdatesCommand}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Content="检查更新"
                        MinHeight="30"
                        Margin="14,0,0,0" />
                    <Button
                        Command="{Binding UpdateAllModsCommand}"
                        Content="全部更新"
                        MinHeight="30"
                        Padding="12,2"
                        Margin="8,0,0,0"
                        Style="{StaticResource BrandPrimaryButton}" />
                </StackPanel>

                <!-- 搜索 + 排序 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Grid.Column="0"
                        Text="{Binding ModSearchText, UpdateSourceTrigger=PropertyChanged}"
                        MinHeight="30"
                        FontSize="12"
                        PlaceholderText="搜索文件名…" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding ModSortModes}"
                        SelectedIndex="{Binding SelectedModSortIndex}"
                        MinWidth="110"
                        MinHeight="30"
                        Margin="10,0,0,0" />
                </Grid>

                <TextBlock
                    Grid.Row="2"
                    Text="{Binding ModListSummary}"
                    FontSize="11"
                    Opacity="0.55"
                    Margin="0,8,0,0" />

                <ScrollViewer Grid.Row="3" MaxHeight="170" Margin="0,4,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Mods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    CornerRadius="8"
                                    Background="#14FFFFFF"
                                    Padding="10,5"
                                    Margin="0,2,8,2">
                                    <Grid MinWidth="620">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Filename}" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Filename}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" FontSize="11"
                                                   Opacity="0.6" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding UpdateStatus}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpdateStatus}" Value="已是最新">
                                                            <Setter Property="Foreground" Value="#7ACC7A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 一键更新:仅在有新版本时出现 -->
                                        <Button
                                            Grid.Column="3"
                                            MinHeight="26"
                                            Padding="10,2"
                                            Margin="12,0,0,0"
                                            Command="{Binding DataContext.UpdateModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BrandPrimaryButton}">
                                                    <Setter Property="Content" Value="更新" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanUpdate}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                            <Setter Property="Content" Value="更新中…" />
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Grid.Column="4"
                                            Content="删除"
                                            MinHeight="26"
                                            Padding="10,2"
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="3"
            Text="{Binding StatusText}"
            Opacity="0.7"
            Margin="0,10,0,0" />
    </Grid>
</Page>
