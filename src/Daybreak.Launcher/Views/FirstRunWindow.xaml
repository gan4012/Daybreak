<ui:FluentWindow
    x:Class="Daybreak.Launcher.Views.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="欢迎使用 Daybreak 破晓启动器"
    Width="640"
    Height="520"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Acrylic"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize">

    <Grid Margin="28,44,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与步骤指示 -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="26" Foreground="{StaticResource BrandAccentBrush}" />
                <TextBlock
                    x:Name="TitleText"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                x:Name="StepIndicator"
                FontSize="12"
                Opacity="0.55"
                Margin="0,6,0,0" />
        </StackPanel>

        <!-- 步骤内容区 -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,18,0,0" Padding="22">
            <Grid>

                <!-- 步骤 1:游戏目录 -->
                <StackPanel x:Name="Step1Panel">
                    <TextBlock Text="选择游戏目录" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Minecraft 的 .minecraft 根目录。留默认即可,已有游戏目录时请指向它以复用现有存档与 Mod。"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,6,0,0" />
                    <ui:TextBox
                        x:Name="GameDirBox"
                        MinHeight="34"
                        Margin="0,14,0,0" />
                    <TextBlock
                        x:Name="GameDirHint"
                        FontSize="11.5"
                        Opacity="0.55"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0" />
                </StackPanel>

                <!-- 步骤 2:内存与镜像 -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="性能与下载设置" FontSize="15" FontWeight="SemiBold" />

                    <TextBlock Text="游戏内存(MB)" FontSize="13" Margin="0,16,0,0" />
                    <TextBlock
                        Text="分配给游戏的堆内存,建议 2048~8192。不确定就保持默认。"
                        FontSize="11.5"
                        Opacity="0.6"
                        Margin="0,2,0,0" />
                    <ui:TextBox x:Name="MemoryBox" MinHeight="34" Margin="0,8,0,0" />
                    <TextBlock
                        x:Name="MemoryHint"
                        FontSize="11.5"
                        Opacity="0.55"
                        Margin="0,6,0,0" />

                    <TextBlock Text="下载镜像" FontSize="13" Margin="0,18,0,0" />
                    <TextBlock
                        Text="国内网络建议选 BMCLAPI(自动加速游戏资源下载);官方源作为回退。"
                        FontSize="11.5"
                        Opacity="0.6"
                        Margin="0,2,0,0" />
                    <ComboBox x:Name="MirrorCombo" MinHeight="32" Margin="0,8,0,0">
                        <ComboBoxItem Content="BMCLAPI 镜像(国内推荐)" />
                        <ComboBoxItem Content="官方源(Mojang)" />
                    </ComboBox>
                </StackPanel>

                <!-- 步骤 3:完成 -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="准备好了" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        Text="设置已完成。接下来:"
                        Opacity="0.7"
                        Margin="0,8,0,0" />
                    <TextBlock
                        Text="1. 在「下载游戏」页安装一个游戏版本(建议正式版)&#x0a;2. 回首页保存账号并点「开始游戏」&#x0a;3. 首次启动会自动下载匹配的 Java 运行时与游戏资源"
                        Opacity="0.75"
                        TextWrapping="Wrap"
                        LineHeight="22"
                        Margin="0,10,0,0" />
                    <TextBlock
                        Text="所有设置之后都能在「设置」页随时修改。"
                        FontSize="11.5"
                        Opacity="0.55"
                        Margin="0,14,0,0" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="SkipButton"
                Grid.Column="0"
                Content="跳过引导"
                MinHeight="36"
                Padding="14,6"
                HorizontalAlignment="Left"
                Click="OnSkip" />

            <Button
                x:Name="BackButton"
                Grid.Column="1"
                Content="上一步"
                MinHeight="36"
                Padding="18,6"
                Margin="0,0,10,0"
                Visibility="Collapsed"
                Click="OnBack" />

            <Button
                x:Name="NextButton"
                Grid.Column="2"
                Content="下一步"
                MinHeight="36"
                Padding="24,6"
                Style="{StaticResource BrandPrimaryButton}"
                Click="OnNext" />
        </Grid>
    </Grid>
</ui:FluentWindow>